# Copy to .env.local and fill in your own links, then `npm run build`.
# Never put secret keys (sk_*) here. Everything prefixed NEXT_PUBLIC_ is public.

# Premium (Stripe Payment Links)
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_ANNUAL=

# One-time packs (Stripe Payment Links, one per pack)
NEXT_PUBLIC_STRIPE_PACK_CRAM=
NEXT_PUBLIC_STRIPE_PACK_WORKSHEETS=
NEXT_PUBLIC_STRIPE_PACK_CUSTOM=

# Fallbacks for Morocco (no card / no Stripe yet) — fastest path to first sale
NEXT_PUBLIC_KOFI_URL=
NEXT_PUBLIC_PAYPAL_ME=
